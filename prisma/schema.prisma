generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  settings      Settings?
  trades        Trade[]
  templates     ChecklistTemplate[]
  snapshots     DailySnapshot[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Settings {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  okxApiKey        String?
  okxSecretKey     String?
  okxPassphrase    String?
  okxApiKeyIv      String?
  okxSecretKeyIv   String?
  okxPassphraseIv  String?
  lastSyncAt       DateTime?
  syncIntervalMin  Int       @default(15)
  autoSync         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId])
  @@index([userId])
}

model Trade {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  clOrdId        String?
  instId         String
  instType       String
  symbol         String
  side           String
  posSide        String?
  entryPrice     Float
  exitPrice      Float?
  quantity       Float
  leverage       Int      @default(1)
  realizedPnl    Float    @default(0)
  fee            Float    @default(0)
  fundingFee     Float    @default(0)
  netPnl         Float    @default(0)
  entryTime      DateTime
  exitTime       DateTime?
  holdDuration   Int?
  status         String   @default("closed")
  notes          String?
  tags           String?
  source         String   @default("okx")
  rawData        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         TradeImage[]
  checklists     TradeChecklist[]

  @@unique([userId, orderId])
  @@index([userId])
  @@index([entryTime])
  @@index([symbol])
  @@index([status])
  @@index([side])
  @@index([instType])
}

model TradeImage {
  id           String   @id @default(uuid())
  tradeId      String
  trade        Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  filePath     String
  fileSize     Int
  mimeType     String
  imageType    String   @default("other")
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([tradeId])
}

model ChecklistTemplate {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phase     String          @default("pre")
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     ChecklistItem[]

  @@index([userId])
}

model ChecklistItem {
  id         String            @id @default(uuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text       String
  category   String            @default("General")
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  responses  TradeChecklist[]

  @@index([templateId])
  @@index([category])
}

model TradeChecklist {
  id              String        @id @default(uuid())
  tradeId         String
  trade           Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  response        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tradeId, checklistItemId])
  @@index([tradeId])
}

model DailySnapshot {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  totalBalance  Float
  availBalance  Float?
  frozenBalance Float?
  dailyPnl      Float    @default(0)
  dailyFee      Float    @default(0)
  tradeCount    Int      @default(0)
  cumulativePnl Float    @default(0)
  source        String   @default("calculated")
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
